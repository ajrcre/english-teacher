{
  "name": "english-teacher",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "tsx scripts/migrate.ts && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test --trace off",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "content:stats": "tsx scripts/content/stats.ts",
    "content:spelling": "tsx scripts/content/gen-spelling.ts",
    "assets:images": "tsx scripts/assets/gen-images.ts",
    "assets:audio": "tsx scripts/assets/gen-audio.ts",
    "assets:icons": "tsx scripts/assets/gen-app-icons.ts",
    "assets:og": "tsx scripts/assets/gen-og-image.ts",
    "eval:grader": "tsx scripts/eval/grader-eval.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.12.0",
    "@google/genai": "^3.6.1",
    "@neondatabase/serverless": "^1.2.1",
    "@node-rs/argon2": "^2.2.2",
    "@radix-ui/react-dialog": "^1.3.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "jose": "^6.2.18",
    "lucide-react": "^1.77.0",
    "motion": "^14.14.0",
    "next": "16.4.6",
    "pino": "^10.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.17",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.10",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.1"
  },
  "engines": {
    "node": ">=20"
  }
