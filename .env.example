# Copy to .env.local for local development. On Vercel, set these in Project → Settings → Environment Variables.

# Postgres (Neon). Added automatically when you connect Neon from the Vercel Marketplace.
# Leave empty locally to use the embedded database in .data/
DATABASE_URL=

# 32+ random characters, e.g. `openssl rand -hex 32`. Required in production.
SESSION_SECRET=

# Which AI grades open answers: "gemini" (default) or "anthropic".
LLM_PROVIDER=gemini
GEMINI_API_KEY=
# GEMINI_GRADER_MODEL=gemini-3.5-flash
# ANTHROPIC_API_KEY=
# ANTHROPIC_GRADER_MODEL=claude-haiku-5-5

# Only needed to regenerate artwork/audio (scripts/assets), never on Vercel.
# ELEVENLABS_API_KEY=
